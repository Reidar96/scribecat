# Files that end up inside the Docker image or are read by Linux tools must
# keep LF endings even on a Windows checkout with core.autocrlf=true: a shell
# script with CRLF fails at "#!/bin/sh\r".
*.sh text eol=lf
server/caddy/Caddyfile text eol=lf
server/Dockerfile text eol=lf

# cargo rewrites this file with LF endings on every build, which otherwise
# shows up as a false-positive diff against the CRLF checkout on Windows.
src-tauri/Cargo.toml text eol=lf
