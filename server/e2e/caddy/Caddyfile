# Caddyfile of the browser test stack (docker-compose.e2e.yml): the site from
# caddy/Caddyfile, plus the scripted model as a second https site so the
# ScribeDog server reaches it the way it reaches a real provider.

{
	# A browser that opens the site by IP address sends no server name, and
	# with more than one site in this file (several instances, the test
	# stack's mock model) Caddy then has nothing to pick a certificate by and
	# drops the handshake. This names the site whose certificate answers such
	# a client; docker-compose.yml defaults it to the site address.
	default_sni {$SCRIBEDOG_DEFAULT_SNI:localhost}
}

{$SCRIBEDOG_SITE_ADDRESS:localhost} {
	tls {$SCRIBEDOG_TLS:internal}

	encode zstd gzip

	reverse_proxy scribedog:3000
}

# The mock model (e2e/mock-llm). The name resolves to this Caddy inside the
# compose network (a network alias), the certificate comes from the local CA.
llm.e2e.internal {
	tls internal

	reverse_proxy mock-llm:8080
}
