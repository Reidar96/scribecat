# Copy to .env and adjust. Every value is optional except the init password
# on the very first start.

# Used only until a password exists in ./scribedog-data; ignored afterwards
# (the server logs a note), so you can remove it once you have signed in.
SCRIBEDOG_INIT_PASSWORD=

# Leave empty to serve the app at https://<host>/ . Set e.g. /anna to serve it
# at https://<host>/anna/ instead (the bare https://<host>/ then answers 404).
SCRIBEDOG_BASE_PATH=

# What Caddy answers on: localhost, the LAN name or IP of the Docker host, or a
# public domain.
SCRIBEDOG_SITE_ADDRESS=localhost

# "internal" uses Caddy's local CA (import its root certificate once, see
# README). For a public domain put your e-mail address here for Let's Encrypt.
SCRIBEDOG_TLS=internal

# Host ports Caddy listens on.
SCRIBEDOG_HTTP_PORT=80
SCRIBEDOG_HTTPS_PORT=443

# User/group id the server runs as; must own ./scribedog-data.
SCRIBEDOG_UID=1000
SCRIBEDOG_GID=1000
