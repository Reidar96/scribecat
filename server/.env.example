# Copy to .env and adjust. Every value is optional except the init password
# on the very first start.

# Eight characters or more, or the server rejects it and keeps restarting
# (Caddy then answers with 502s until you fix this). Used only until a
# password exists in ./scribecat-data; ignored afterwards (the server logs a
# note), so you can remove it once you have signed in.
SCRIBECAT_INIT_PASSWORD=

# Leave empty to serve the app at https://<host>/ . Set e.g. /anna to serve it
# at https://<host>/anna/ instead (the bare https://<host>/ then answers 404).
SCRIBECAT_BASE_PATH=

# What Caddy answers on. Leave as localhost only if you will open the app on
# this same machine; opening it from a phone, another computer, or anywhere
# else on the network (the usual case for a Pi or home server) needs the
# box's actual LAN name or IP here instead, e.g. 192.168.1.50, or Caddy will
# not answer that request at all. A public domain works too.
SCRIBECAT_SITE_ADDRESS=localhost

# Only needed if SCRIBECAT_SITE_ADDRESS lists several addresses: the one the
# certificate is picked for when a browser names none, which is what happens
# when the app is opened by IP address. Defaults to the site address.
#SCRIBECAT_DEFAULT_SNI=192.168.1.10

# "internal" uses Caddy's local CA (import its root certificate once, see
# README). For a public domain put your e-mail address here for Let's Encrypt.
SCRIBECAT_TLS=internal

# Host ports Caddy listens on.
SCRIBECAT_HTTP_PORT=80
SCRIBECAT_HTTPS_PORT=443

# Published image to run instead of building locally. Already set to the
# current version, so there is nothing to change here for the latest release;
# set it to an older tag yourself if you want one on purpose, or leave it
# empty to build from this repository instead. Only exact versions are
# published, there is no "latest" tag to track automatically.
SCRIBECAT_IMAGE=ghcr.io/Reidar96/scribecat-server:0.15.1

# User/group id the server runs as and that ./scribecat-data is handed to on
# start. Match your own user (id -u / id -g) so the notes stay yours on the host.
PUID=1000
PGID=1000
