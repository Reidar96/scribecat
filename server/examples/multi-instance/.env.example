# Copy to .env. One init password per instance; each is used only until that
# instance has a password in its data folder, then it can be removed.
ANNA_INIT_PASSWORD=
BOB_INIT_PASSWORD=

# One Linux user per instance keeps the data folders apart on the host
# (see README, "Several people on one host"): id -u / id -g of that user.
ANNA_PUID=1000
ANNA_PGID=1000
BOB_PUID=1001
BOB_PGID=1001

# Host name or IP the site answers on, and the certificate mode (see the
# single-instance .env.example).
SCRIBEDOG_SITE_ADDRESS=localhost
SCRIBEDOG_TLS=internal
SCRIBEDOG_HTTP_PORT=80
SCRIBEDOG_HTTPS_PORT=443

# Published image instead of a local build, e.g.
# ghcr.io/snooky234/scribedog-server:0.11.0
#SCRIBEDOG_IMAGE=
