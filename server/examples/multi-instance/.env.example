# ANNA and BOB are just example names here, in docker-compose.yml and in the
# Caddyfile; rename all three to whatever you like, as long as the name
# matches across the three files. Starting with only one of them, or with
# more than two, works the same way; see docs/multiuser.md for adding or
# removing one later.
#
# Copy to .env. Eight characters or more each, or that instance rejects it
# and keeps restarting (Caddy then answers with 502s for it until fixed). One
# init password per instance; each is used only until that instance has a
# password in its data folder, then it can be removed.
ANNA_INIT_PASSWORD=
BOB_INIT_PASSWORD=

# One Linux user per instance keeps the data folders apart on the host
# (see docs/multiuser.md, "Keeping the folders apart"): id -u / id -g of that user.
ANNA_PUID=1000
ANNA_PGID=1000
BOB_PUID=1001
BOB_PGID=1001

# Host name or IP the site answers on, and the certificate mode (see the
# single-instance .env.example).
SCRIBEDOG_SITE_ADDRESS=localhost
SCRIBEDOG_TLS=internal
SCRIBEDOG_HTTP_PORT=80
SCRIBEDOG_HTTPS_PORT=443

# Published image instead of a local build. Already set to the current
# version; leave it as is for the latest release, set an older tag on
# purpose, or empty it to build from the repository instead.
SCRIBEDOG_IMAGE=ghcr.io/snooky234/scribedog-server:0.12.0
